  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sgmg_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Reservation": {
        "type": "object",
        "required": [
          "slotId"
        ],
        "properties": {
          "slotId": {
            "type": "string"
          }
        }
      },
      "Payment": {
        "type": "object",
        "required": [
          "appointmentId",
          "amount",
          "method"
        ],
        "properties": {
          "appointmentId": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "card",
              "document",
              "fonasa",
              "isapre"
            ]
          },
          "voucherReference": {
            "type": "string"
          }
        }
      }
    }
